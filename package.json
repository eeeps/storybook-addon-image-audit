{
  "name": "storybook-addon-image-audit",
  "version": "0.0.1",
  "description": "Audit image compression, layout density, and resource sizes in Storybook.",
  "keywords": [
    "storybook-addons",
    "storybook-addon",
    "image",
    "img",
    "debug",
    "performance"
  ],
  "license": "ISC",
  "author": "Eric Portis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeeps/storybook-image-audit.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/preset.js",
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "dependencies": {
    "@oddbird/css-anchor-positioning": "^0.10.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "npm run build",
    "release": "npm run typecheck && npm run build && auto shipit"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "auto": "^11.3.0",
    "react": "^19.0.0",
    "storybook": "^10.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Image Audit"
  }
}
